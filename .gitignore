# Build output.
# The binary entry is anchored to the repo root on purpose: an unanchored
# "plumbline" also matches the cmd/plumbline/ directory, which silently
# excludes the CLI from every `git add`.
/bin/
/dist/
/plumbline

# Logs
*.log

# Go test/coverage artifacts
*.test
*.out

# Rust build output from testdata contracts
target/

# Ledger snapshots soroban-sdk writes during contract tests
test_snapshots/

# Corpus checkouts. These are third-party repositories fetched at a pinned
# commit by `make corpus`; the pins live in corpus/repos.txt, the contents do
# not belong in this repository.
/corpus/checkouts/

# Editor / OS
.DS_Store
.idea/
.vscode/
